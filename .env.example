APP_ENV=development
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0
S3_BUCKET=short-drama-assets
AWS_REGION=ap-southeast-1
MAX_REVISION_ATTEMPTS=2
MEDIA_CONCURRENCY=4

# Fernet key used to encrypt provider API keys at rest.
